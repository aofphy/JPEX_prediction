# Per-issuance prediction matrices (large; deposited on Zenodo per the paper)
results/*.npz
results/*_preds.csv
results/*_mu.csv
results/*_sigma.csv

# Keep small JSON metrics + summary CSVs for replication verification
!results/*_metrics.json
!results/*_results.json
!results/*_summary.csv
!results/*_summary.json
!results/*sensitivity.json

# Standard exclusions
__pycache__/
*.pyc
*.pyo
.DS_Store
.ipynb_checkpoints/

# LaTeX build artefacts (keep main.pdf + cover_letter.pdf)
tex/*.aux
tex/*.bbl
tex/*.blg
tex/*.log
tex/*.out
tex/*.toc
tex/*.fls
tex/*.fdb_latexmk
tex/*.synctex.gz
tex/auto/

# Other
*.swp
*.swo
*~
